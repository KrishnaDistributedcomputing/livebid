POSTGRES_DB=livebid
POSTGRES_USER=livebid
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-secret
REDIS_PASSWORD=replace-with-a-different-long-random-alphanumeric-secret
DATABASE_URL=postgresql://livebid:replace-with-the-postgres-secret@postgres:5432/livebid
REDIS_URL=redis://:replace-with-the-redis-secret@redis:6379
APP_ORIGIN=https://livebid.example.com
LIVEBID_PORT=3001
SESSION_COOKIE_NAME=livebid_session
SESSION_TTL_HOURS=168
LIVEBID_IMAGE=ghcr.io/krishnadistributedcomputing/livebid:latest
